# Hydra IDE — variables de entorno (COPIA este archivo a ".env" y NO lo subas a git).
#
# En PRODUCCIÓN las claves NO van aquí: viven en los "secrets" de la Edge Function
# de Supabase (supabase secrets set ...). Este archivo es solo para desarrollo
# local si algún día quisieras pegar directo a los proveedores sin el proxy.

# URL del proxy (Edge Function). La app ya trae una por defecto; cambiala solo si
# usas otro proyecto de Supabase u otro entorno. NO es secreta.
HYDRA_AI_PROXY=

# --- Solo si corres SIN proxy en local (opcional; NO empaquetar con claves) -----
CEREBRAS_API_KEY=
GROQ_API_KEY=
LUMIN_TOKEN=
